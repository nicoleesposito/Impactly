# Supabase project credentials (client-safe — protected by Row-Level Security).
# Copy this file to `.env` and fill in the values from your Supabase project settings.
# VITE_SUPABASE_URL:        Settings → General → Project URL
# VITE_SUPABASE_PUBLISHABLE_KEY: Settings → API Keys → Publishable key (sb_publishable_...)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
